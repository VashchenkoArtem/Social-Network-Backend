model Album {
  id        Int      @id @default(autoincrement())
  name     String
  is_shown Boolean  @default(true)

  profile    User     @relation(fields: [profileId], references: [id])
  profileId  Int

  theme     String

  year      Int
  created_at DateTime @default(now())
  is_default Boolean
  photos    AlbumImage[]
}

model AlbumImage{
  id        Int     @id @default(autoincrement())
  created_at DateTime @default(now())
  image     String
  is_shown Boolean  @default(true)
  album     Album?  @relation(fields: [albumId], references: [id])
  albumId   Int?
}
model Photo {
  id        Int     @id @default(autoincrement())
  filename  String
  
  user      User?   @relation(fields: [userId], references: [id])
  userId    Int?

  avatarFor User?   @relation("UserAvatars", fields: [avatarForId], references: [id])
  avatarForId Int?

  isVisible Boolean @default(true)
}