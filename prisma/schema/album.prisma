model profile_app_album {
  id        Int      @id @default(autoincrement())
  name     String
  is_shown Boolean  @default(true)
  profile    profile_app_profile     @relation(fields: [profileId], references: [id])
  profileId  Int
  theme     String
  year      Int
  created_at DateTime @default(now())
  is_default Boolean
  photos    profile_app_albumimage[]
}

model profile_app_albumimage{
  id        Int     @id @default(autoincrement())
  created_at DateTime @default(now())
  image     String
  is_shown Boolean  @default(true)
  album     profile_app_album?  @relation(fields: [albumId], references: [id])
  albumId   Int?
}
