model post_app_post{
  id    Int @id @default(autoincrement())
  title String
  topic String
  content String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  tags post_app_post_tags[]
  urls PostUrl[]
  photos PostImage[]
  likes PostLike[]
  hearts PostHeart[]
  views PostView[]
  author User @relation(fields: [authorId], references: [id])
  authorId Int
}

model post_app_post_tags{
  post       post_app_post     @relation(fields: [postId], references: [id])
  postId Int
  tag       post_app_tag @relation(fields: [tagId], references: [id])
  tagId Int
  @@id([postId, tagId])
}

model PostUrl{
  id    Int @id @default(autoincrement())
  href  String
  post  post_app_post @relation(fields: [postId], references: [id])
  postId Int
}

model post_app_tag {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  posts       post_app_post_tags[]
}
model PostImage{
  id          Int         @id @default(autoincrement())
  original_image String
  post     post_app_post? @relation(fields: [postId], references: [id])
  postId   Int?
}
model PostLike{
  id          Int         @id @default(autoincrement())
  post     post_app_post? @relation(fields: [postId], references: [id])
  postId   Int?
  user     User? @relation(fields: [userId], references: [id])
  userId   Int?
}

model PostHeart{
  id          Int         @id @default(autoincrement())
  post     post_app_post? @relation(fields: [postId], references: [id])
  postId   Int?
  user     User? @relation(fields: [userId], references: [id])
  userId   Int?
}

model PostView{
  id          Int         @id @default(autoincrement())
  post     post_app_post? @relation(fields: [postId], references: [id])
  postId   Int?
  user     User? @relation(fields: [userId], references: [id])
  userId   Int?
}