model user_app_user {
  id          Int      @id @default(autoincrement())
  firstname   String?
  lastname    String?
  username    String?
  email       String   @unique
  password    String
  sentFriendRequests user_app_friendrequest[] @relation("SentRequests")
  receivedFriendRequests user_app_friendrequest[] @relation("ReceivedRequests")
  profile profile_app_profile? @relation(fields: [profileId], references: [id])
  profileId Int? @unique
  chats chat_app_chat_users[]
  admin chat_app_chat[] @relation("ChatAdmin")
  sentMessages chat_app_message[]
  readMessages chat_app_message[] @relation("MessageReaders")
}

model profile_app_profile{
  id          Int      @id @default(autoincrement())
  signature   String?
  birth_date   DateTime?
  avatar      String?
  pseudonym   String?
  is_image_signature  Boolean @default(false)
  is_text_signature Boolean @default(true)

  albums      profile_app_album[]
  posts       post_app_post[]
  likes       post_app_postlike[]
  hearts      post_app_postheart[]
  views       post_app_postview[]
  user        user_app_user?
}
model user_app_friendrequest{
  id          Int      @id @default(autoincrement())
  status String? @default("Pending")

  from_profile user_app_user @relation("SentRequests", fields: [senderId], references: [id])
  senderId     Int

  to_profile   user_app_user @relation("ReceivedRequests", fields: [receiverId], references: [id])
  receiverId   Int
}